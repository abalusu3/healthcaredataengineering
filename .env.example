# Copy to .env and adjust. All values below are LOCAL DEV defaults only.

# --- Airflow ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=change-me-local-jwt-secret

# --- Postgres (one server: airflow metadata DB + warehouse DB) ---
POSTGRES_SUPERUSER_PASSWORD=postgres
AIRFLOW_DB_PASSWORD=airflow
WAREHOUSE_DB=readmitiq
WAREHOUSE_USER=readmitiq
WAREHOUSE_PASSWORD=readmitiq

# --- Object storage (SeaweedFS S3 gateway; creds must match docker/seaweedfs/s3.json) ---
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=readmitiq
S3_SECRET_KEY=readmitiq-local-secret
LAKE_BUCKET=readmitiq-lake

# --- Synthea synthetic population ---
# Centene's largest Medicaid footprints; space-separated state names.
SYNTHEA_STATES="Missouri Texas Georgia"
SYNTHEA_POPULATION_PER_STATE=3000
SYNTHEA_SEED=42
